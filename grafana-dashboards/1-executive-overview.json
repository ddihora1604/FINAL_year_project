{
  "dashboard": {
    "title": "RAG Pipeline - Executive Overview",
    "tags": ["rag", "executive", "overview"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Queries (24h)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(rag_queries_total[24h]))",
            "refId": "A",
            "legendFormat": "Total Queries"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value",
          "text": {"titleSize": 16, "valueSize": 48}
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            },
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 2,
        "title": "Attack Attempts (24h)",
        "type": "stat",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(rag_security_attacks_total[24h]))",
            "refId": "A",
            "legendFormat": "Attacks"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value",
          "text": {"titleSize": 16, "valueSize": 48}
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            },
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 3,
        "title": "P95 Latency",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 2, "color": "yellow"},
                {"value": 3, "color": "red"}
              ]
            },
            "unit": "s",
            "min": 0,
            "max": 5,
            "decimals": 2
          }
        }
      },
      {
        "id": 4,
        "title": "Success Rate",
        "type": "piechart",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(rag_queries_total{status=\"success\"}[24h]))",
            "refId": "A",
            "legendFormat": "Success"
          },
          {
            "expr": "sum(increase(rag_queries_total{status=\"blocked\"}[24h]))",
            "refId": "B",
            "legendFormat": "Blocked"
          },
          {
            "expr": "sum(increase(rag_queries_total{status=\"no_context\"}[24h]))",
            "refId": "C",
            "legendFormat": "No Context"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true,
            "values": ["value", "percent"]
          },
          "pieType": "pie",
          "tooltip": {
            "mode": "single"
          },
          "displayLabels": ["percent"]
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Success"},
              "properties": [
                {"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Blocked"},
              "properties": [
                {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "No Context"},
              "properties": [
                {"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}
              ]
            }
          ]
        }
      },
      {
        "id": 5,
        "title": "Query Rate Timeline (7 Days)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 18, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(rag_queries_total[5m])) * 60",
            "refId": "A",
            "legendFormat": "Queries/min"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 30,
              "showPoints": "never",
              "axisPlacement": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqpm",
            "min": 0
          }
        }
      },
      {
        "id": 6,
        "title": "Top 5 Attack Types",
        "type": "barchart",
        "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "topk(5, sum by (attack_type) (increase(rag_security_attacks_total[24h])))",
            "refId": "A",
            "legendFormat": "{{attack_type}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "xTickLabelRotation": 0,
          "xTickLabelSpacing": 100,
          "showValue": "always",
          "legend": {
            "displayMode": "list",
            "placement": "right",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "custom": {
              "axisPlacement": "auto",
              "barAlignment": 0,
              "fillOpacity": 80
            }
          }
        }
      }
    ]
  }
}
