{
  "dashboard": {
    "title": "RAG Pipeline - Complete Monitoring",
    "tags": ["rag", "monitoring", "security", "performance", "quality"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "📊 EXECUTIVE OVERVIEW",
        "type": "row",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 2,
        "title": "Total Queries (24h)",
        "type": "stat",
        "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(rag_queries_total[24h]))",
            "refId": "A",
            "legendFormat": "Total Queries"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            },
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 3,
        "title": "Attack Attempts (24h)",
        "type": "stat",
        "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "sum(increase(rag_security_attacks_total[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            },
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 4,
        "title": "P95 Latency",
        "type": "gauge",
        "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 2, "color": "yellow"},
                {"value": 3, "color": "red"}
              ]
            },
            "unit": "s",
            "min": 0,
            "max": 5,
            "decimals": 2
          }
        }
      },
      {
        "id": 5,
        "title": "Success Rate",
        "type": "piechart",
        "gridPos": {"x": 12, "y": 1, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(rag_queries_total{status=\"success\"}[24h]))",
            "refId": "A",
            "legendFormat": "Success"
          },
          {
            "expr": "sum(increase(rag_queries_total{status=\"blocked\"}[24h]))",
            "refId": "B",
            "legendFormat": "Blocked"
          },
          {
            "expr": "sum(increase(rag_queries_total{status=\"no_context\"}[24h]))",
            "refId": "C",
            "legendFormat": "No Context"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "values": ["value", "percent"]
          },
          "pieType": "pie",
          "displayLabels": ["percent"]
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Top 5 Attack Types",
        "type": "barchart",
        "gridPos": {"x": 18, "y": 1, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "topk(5, sum by (attack_type) (increase(rag_security_attacks_total[24h])))",
            "refId": "A",
            "legendFormat": "{{attack_type}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "showValue": "always",
          "legend": {
            "displayMode": "hidden"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "custom": {
              "fillOpacity": 80
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Query Rate Timeline (7 Days)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 5, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(rag_queries_total[5m])) * 60",
            "refId": "A",
            "legendFormat": "Queries/min"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 30,
              "showPoints": "never"
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqpm",
            "min": 0
          }
        }
      },
      {
        "id": 10,
        "title": "🔒 SECURITY OPERATIONS",
        "type": "row",
        "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 11,
        "title": "Real-time Attack Timeline (1h)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 10, "w": 16, "h": 8},
        "targets": [
          {
            "expr": "sum by (attack_type) (rate(rag_security_attacks_total[1m])) * 60",
            "refId": "A",
            "legendFormat": "{{attack_type}}"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "calcs": ["lastNotNull", "max", "mean"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "auto"
            },
            "color": {"mode": "palette-classic"},
            "unit": "attpm",
            "min": 0
          }
        }
      },
      {
        "id": 12,
        "title": "Attack Type Distribution",
        "type": "piechart",
        "gridPos": {"x": 16, "y": 10, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "sum by (attack_type) (increase(rag_security_attacks_total[24h]))",
            "refId": "A",
            "legendFormat": "{{attack_type}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "showLegend": true,
            "values": ["value", "percent"]
          },
          "pieType": "donut",
          "displayLabels": ["name", "percent"]
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 13,
        "title": "PII Redaction by Entity Type",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum by (entity_type) (increase(rag_security_pii_redacted_total[1h]))",
            "refId": "A",
            "legendFormat": "{{entity_type}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "continuous-GrYlRd"
            },
            "unit": "short",
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 14,
        "title": "Blocked vs Allowed Queries",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(rag_queries_total{status=\"success\"}[5m])) * 60",
            "refId": "A",
            "legendFormat": "Allowed"
          },
          {
            "expr": "sum(rate(rag_queries_total{status=\"blocked\"}[5m])) * 60",
            "refId": "B",
            "legendFormat": "Blocked"
          },
          {
            "expr": "sum(rate(rag_queries_total{status=\"no_context\"}[5m])) * 60",
            "refId": "C",
            "legendFormat": "No Context"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 50,
              "stacking": {"mode": "normal"}
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqpm"
          }
        }
      },
      {
        "id": 20,
        "title": "⚡ PERFORMANCE METRICS",
        "type": "row",
        "gridPos": {"x": 0, "y": 24, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 21,
        "title": "Request Latency Percentiles (P50, P95, P99)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 25, "w": 14, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
            "refId": "A",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
            "refId": "B",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
            "refId": "C",
            "legendFormat": "P99"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "calcs": ["lastNotNull", "mean", "max"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10
            },
            "color": {"mode": "palette-classic"},
            "unit": "s",
            "min": 0
          }
        }
      },
      {
        "id": 22,
        "title": "Slowest Queries Alert",
        "type": "stat",
        "gridPos": {"x": 14, "y": 25, "w": 5, "h": 4},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(rag_request_duration_seconds_bucket[5m])) by (le))",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 3, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            },
            "unit": "s",
            "decimals": 3
          }
        }
      },
      {
        "id": 23,
        "title": "Vector Store Size",
        "type": "stat",
        "gridPos": {"x": 19, "y": 25, "w": 5, "h": 4},
        "targets": [
          {
            "expr": "rag_vector_store_documents",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 24,
        "title": "Requests Per Second",
        "type": "timeseries",
        "gridPos": {"x": 14, "y": 29, "w": 10, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(rag_queries_total[1m]))",
            "refId": "A",
            "legendFormat": "RPS"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": ["mean", "max", "lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 40
            },
            "color": {"mode": "palette-classic"},
            "unit": "reqps",
            "min": 0
          }
        }
      },
      {
        "id": 25,
        "title": "Latency Distribution Heatmap",
        "type": "heatmap",
        "gridPos": {"x": 0, "y": 33, "w": 14, "h": 8},
        "targets": [
          {
            "expr": "sum(increase(rag_request_duration_seconds_bucket[1m])) by (le)",
            "refId": "A",
            "format": "heatmap"
          }
        ],
        "options": {
          "calculate": false,
          "color": {
            "mode": "scheme",
            "scheme": "Spectral"
          },
          "yAxis": {
            "unit": "s"
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false
              }
            }
          }
        }
      },
      {
        "id": 26,
        "title": "Average Latency by Status",
        "type": "barchart",
        "gridPos": {"x": 14, "y": 33, "w": 10, "h": 8},
        "targets": [
          {
            "expr": "sum by (status) (rate(rag_request_duration_seconds_sum[5m])) / sum by (status) (rate(rag_request_duration_seconds_count[5m]))",
            "refId": "A",
            "legendFormat": "{{status}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "showValue": "always",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "s",
            "decimals": 3,
            "custom": {
              "fillOpacity": 80
            }
          }
        }
      },
      {
        "id": 30,
        "title": "✨ QUALITY METRICS",
        "type": "row",
        "gridPos": {"x": 0, "y": 41, "w": 24, "h": 1},
        "collapsed": false
      },
      {
        "id": 31,
        "title": "Average Similarity Score",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 42, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(rag_similarity_score_sum[5m])) / sum(rate(rag_similarity_score_count[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 0.5, "color": "yellow"},
                {"value": 0.7, "color": "green"}
              ]
            },
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "decimals": 3
          }
        }
      },
      {
        "id": 32,
        "title": "Refusal Rate %",
        "type": "stat",
        "gridPos": {"x": 6, "y": 42, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(rag_content_refusals_total[5m])) / sum(rate(rag_queries_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 25, "color": "red"}
              ]
            },
            "unit": "percent",
            "decimals": 2
          }
        }
      },
      {
        "id": 33,
        "title": "Conversation Length",
        "type": "stat",
        "gridPos": {"x": 12, "y": 42, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "rag_conversation_history_length",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "textMode": "value_and_name",
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 34,
        "title": "Query Status Breakdown",
        "type": "barchart",
        "gridPos": {"x": 18, "y": 42, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum by (status) (increase(rag_queries_total[1h]))",
            "refId": "A",
            "legendFormat": "{{status}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "showValue": "always",
          "stacking": "normal",
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "custom": {
              "fillOpacity": 80
            }
          }
        }
      },
      {
        "id": 35,
        "title": "Similarity Score Distribution",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 48, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(increase(rag_similarity_score_bucket[5m])) by (le)",
            "refId": "A",
            "legendFormat": "≤ {{le}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 100
            },
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 36,
        "title": "Similarity Score Timeline",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 48, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(rag_similarity_score_sum[5m])) / sum(rate(rag_similarity_score_count[5m]))",
            "refId": "A",
            "legendFormat": "Average"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_similarity_score_bucket[5m])) by (le))",
            "refId": "B",
            "legendFormat": "P95"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": ["mean", "lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10
            },
            "color": {"mode": "palette-classic"},
            "unit": "percentunit",
            "min": 0,
            "max": 1
          }
        }
      },
      {
        "id": 37,
        "title": "Vector Store Growth",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 54, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "rag_vector_store_documents",
            "refId": "A",
            "legendFormat": "Documents"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": ["lastNotNull", "delta"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 40
            },
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "min": 0
          }
        }
      },
      {
        "id": 38,
        "title": "Conversation Length Trend",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 54, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "rag_conversation_history_length",
            "refId": "A",
            "legendFormat": "Messages"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "calcs": ["lastNotNull", "mean", "max"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 20
            },
            "color": {"mode": "palette-classic"},
            "unit": "short",
            "min": 0
          }
        }
      }
    ]
  }
}
